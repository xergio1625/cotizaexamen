---
import { siteConfig } from '../../site.config';
import { getOfferIndex, STALE_DAYS } from '../lib/prices';
import { getArancel, LEVELS, fastingText } from '../lib/arancel';

const items = await getArancel();
const { byExam, subRegions } = await getOfferIndex();

// Datos compactos para el navegador. lv = [[total, benef] | null] para niveles 1, 2 y 3.
// Los precios NO van en la página: el navegador pide /data/ofertas/<examen>.json al elegir cada examen.
const data = {
  locale: siteConfig.country.locale,
  currency: siteConfig.country.currency,
  staleDays: STALE_DAYS,
  subLabel: siteConfig.country.subdivisionLabel,
  exams: items.map((i) => ({
    id: i.id,
    code: i.code,
    noFonasa: i.noFonasa,
    name: i.name,
    official: i.official === i.name ? '' : i.official,
    lv: LEVELS.map((n) => (i.levels[n] ? [i.levels[n]!.total, i.levels[n]!.benef] : null)),
    guide: i.guide ?? '',
    slug: i.slug,
    fasting: i.guide ? fastingText(i.fasting) : '',
    fastingRequired: i.fasting ? i.fasting.required : null,
    urgent: i.urgent?.note ?? '',
    stability: i.stability?.text ?? '',
    derivable: i.stability?.derivable ?? null,
    priced: byExam.has(i.id),
  })),
  subRegions,
};
---

<section class="cotizador" aria-labelledby="cz-title">
  <div class="cz-head">
    <div>
      <h2 id="cz-title">Cotiza los exámenes de tu orden</h2>
      <p class="muted">
        Busca cada examen que te pidieron, por nombre o por código FONASA. Verás su valor de referencia en FONASA, los
        precios de prestadores y si alguno requiere preparación. Lo que eliges se queda en tu navegador: no guardamos
        tu lista ni la asociamos a ti.
      </p>
    </div>
    <img src="/img/cotizador.webp" alt="" width="1408" height="768" loading="lazy" decoding="async" />
  </div>

  <div class="cz-search">
    <label for="cz-input">Buscar examen ({items.length} disponibles)</label>
    <input id="cz-input" type="search" autocomplete="off" placeholder="Ej.: hemograma, glucosa, TSH o 03 01 045" />
    <ul id="cz-suggest" class="cz-suggest" role="listbox" aria-label="Sugerencias" hidden></ul>
  </div>

  <ul id="cz-chips" class="cz-chips" aria-label="Exámenes seleccionados"></ul>

  <div id="cz-alerts"></div>
  <div id="cz-fonasa"></div>
  <div id="cz-results" aria-live="polite"></div>
  <div id="cz-prep"></div>

  <noscript>
    <p class="notice">
      El cotizador necesita JavaScript. Sin él, busca cada examen en
      <a href="/precios/">la lista completa</a>.
    </p>
  </noscript>

  <script type="application/json" id="cz-data" set:html={JSON.stringify(data)} />
</section>

<script>
  type Lv = [number, number] | null;
  type Exam = { id: string; code: string; noFonasa: boolean; name: string; official: string; lv: Lv[]; guide: string; slug: string; fasting: string; fastingRequired: boolean | null; urgent: string; stability: string; derivable: boolean | null; priced: boolean };
  type Offer = { examId: string; provider: string; website: string; kind: string; subdivisions: string[]; regionalOnly: boolean; fonasaLevel: number; amount: number; verifiedAt: string };
  type Group = { provider: string; website: string; kind: string; fonasaLevel: number; items: Map<string, Offer>; subs: Set<string>; oldest: string };

  const data = JSON.parse(document.getElementById('cz-data')!.textContent!) as {
    locale: string; currency: string; staleDays: number; subLabel: string; subRegions: Record<string, string>; exams: Exam[];
  };
  const money = new Intl.NumberFormat(data.locale, { style: 'currency', currency: data.currency, maximumFractionDigits: 0 });
  const dateFmt = new Intl.DateTimeFormat(data.locale, { dateStyle: 'medium', timeZone: 'UTC' });
  const collator = new Intl.Collator('es', { sensitivity: 'base' });
  const norm = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
  const kindLabel: Record<string, string> = { particular: 'Particular', convenio: 'Convenio', promocion: 'Promoción' };
  const examById = new Map(data.exams.map((e) => [e.id, e]));
  // Índice de búsqueda: nombre + denominación oficial + código sin separadores.
  const haystack = new Map(data.exams.map((e) => [e.id, `${norm(e.name)} ${norm(e.official)} ${e.code.replace(/ /g, '')}`]));
  const short = (s: string, n = 70) => (s.length > n ? s.slice(0, n - 1).trimEnd() + '…' : s);
  const Sub = data.subLabel[0].toUpperCase() + data.subLabel.slice(1);

  const input = document.getElementById('cz-input') as HTMLInputElement;
  const suggest = document.getElementById('cz-suggest')!;
  const chips = document.getElementById('cz-chips')!;
  const alerts = document.getElementById('cz-alerts')!;
  const fonasa = document.getElementById('cz-fonasa')!;
  const results = document.getElementById('cz-results')!;
  const prep = document.getElementById('cz-prep')!;

  let selected: string[] = [];
  let order: 'price' | 'subdivision' | 'alpha' = 'price';
  let sub = '';
  let region = '';

  /* ---------- Precios bajo demanda ----------
     Los precios no viajan con la página: al elegir un examen se pide /data/ofertas/<código>.json
     (un archivo por examen) y se guarda en memoria. Un examen sin precios no pide nada. */
  const offersByExam = new Map<string, Offer[]>();
  const loading = new Set<string>();
  const failed = new Set<string>();
  const poolOffers = () => selected.flatMap((id) => offersByExam.get(id) ?? []);

  function loadOffers(id: string) {
    if (offersByExam.has(id) || loading.has(id)) return;
    if (!examById.get(id)!.priced) { offersByExam.set(id, []); return; }
    loading.add(id);
    failed.delete(id);
    // El servidor de desarrollo, con trailingSlash 'always', solo sirve este archivo con barra final.
    fetch(`/data/ofertas/${id}.json${import.meta.env.DEV ? '/' : ''}`)
      .then((r) => { if (!r.ok) throw new Error(String(r.status)); return r.json() as Promise<Omit<Offer, 'examId'>[]>; })
      .then((list) => offersByExam.set(id, list.map((o) => ({ ...o, examId: id }))))
      .catch(() => failed.add(id))
      .finally(() => { loading.delete(id); if (selected.includes(id)) renderResults(); });
  }

  function h(tag: string, attrs: Record<string, string> = {}, ...kids: (Node | string)[]) {
    const n = document.createElement(tag);
    for (const [k, v] of Object.entries(attrs)) n.setAttribute(k, v);
    n.append(...kids);
    return n;
  }

  /* ---------- Búsqueda y selección ---------- */
  function showSuggestions() {
    const q = norm(input.value.trim()).replace(/(\d)\s+(?=\d)/g, '$1');
    suggest.replaceChildren();
    if (!q) { suggest.hidden = true; return; }
    const tokens = q.split(/\s+/).filter(Boolean);
    const matches = data.exams
      .filter((e) => !selected.includes(e.id) && tokens.every((t) => haystack.get(e.id)!.includes(t)))
      .sort((a, b) => {
        const sa = norm(a.name).startsWith(tokens[0]) ? 0 : 1;
        const sb = norm(b.name).startsWith(tokens[0]) ? 0 : 1;
        return sa - sb || a.name.length - b.name.length;
      })
      .slice(0, 8);
    matches.forEach((e) => {
      const b = h('button', { type: 'button', role: 'option', title: e.official || e.name }, short(e.name), h('span', { class: 'muted small' }, `  ${e.code}`));
      b.addEventListener('click', () => add(e.id));
      suggest.append(h('li', {}, b));
    });
    if (!matches.length) suggest.append(h('li', { class: 'cz-none' }, 'Sin resultados. Prueba con otra palabra o con el código.'));
    suggest.hidden = false;
  }

  function add(id: string) {
    if (!selected.includes(id)) selected.push(id);
    loadOffers(id);
    input.value = '';
    suggest.hidden = true;
    input.focus();
    render();
  }
  function remove(id: string) {
    selected = selected.filter((x) => x !== id);
    render();
  }

  input.addEventListener('input', showSuggestions);
  input.addEventListener('keydown', (ev) => {
    if (ev.key === 'Enter') {
      ev.preventDefault();
      suggest.querySelector('button')?.click();
    } else if (ev.key === 'Escape') suggest.hidden = true;
  });
  document.addEventListener('click', (ev) => {
    if (!(ev.target as Element).closest('.cz-search')) suggest.hidden = true;
  });

  /* Los prestadores locales (regionalOnly) solo se muestran cuando se filtra por su región. */
  const regionOfSub = (s: string) => data.subRegions[s] ?? '';
  const inRegion = (s: string) => !region || regionOfSub(s) === region;
  /* Comunas de un precio que cumplen el filtro actual. Un precio sin comunas vale para todas. */
  const relevantSubs = (o: Offer) => o.subdivisions.filter((s) => inRegion(s) && (!sub || s === sub));
  const visible = (o: Offer) => (region ? !o.subdivisions.length || o.subdivisions.some(inRegion) : !o.regionalOnly);

  /* ---------- Cálculo de prestadores ---------- */
  function buildGroups(): Group[] {
    const map = new Map<string, Group>();
    for (const o of poolOffers()) {
      if (!visible(o)) continue;
      const subs = relevantSubs(o);
      if (o.subdivisions.length && !subs.length) continue;
      const key = `${o.provider}|${o.kind}`;
      let g = map.get(key);
      if (!g) {
        g = { provider: o.provider, website: o.website, kind: o.kind, fonasaLevel: o.fonasaLevel, items: new Map(), subs: new Set(), oldest: o.verifiedAt };
        map.set(key, g);
      }
      const cur = g.items.get(o.examId);
      if (!cur || o.amount < cur.amount) g.items.set(o.examId, o);
      subs.forEach((s) => g.subs.add(s));
      if (o.verifiedAt < g.oldest) g.oldest = o.verifiedAt;
    }
    return [...map.values()];
  }
  const total = (g: Group) => [...g.items.values()].reduce((s, o) => s + o.amount, 0);
  const firstSub = (g: Group) => [...g.subs].sort(collator.compare)[0] ?? '~';
  const byName = (a: Group, b: Group) => collator.compare(a.provider, b.provider);

  /* ---------- Render ---------- */
  function render() {
    chips.replaceChildren(
      ...selected.map((id) => {
        const e = examById.get(id)!;
        const b = h('button', { type: 'button', 'aria-label': `Quitar ${e.name}` }, '×');
        b.addEventListener('click', () => remove(id));
        return h('li', { class: 'chip', title: e.official || e.name }, short(e.name, 48), b);
      }),
    );
    renderAlerts();
    renderFonasa();
    renderResults();
    renderPrep();
  }

  /* Avisos por examen: no admite demora y estabilidad de la muestra. */
  function renderAlerts() {
    alerts.replaceChildren();
    for (const id of selected) {
      const e = examById.get(id)!;
      if (e.urgent) {
        alerts.append(h('p', { class: 'notice notice-urgent' }, h('strong', {}, `${short(e.name, 60)}: examen que no admite demora. `), e.urgent));
      }
      if (e.stability) {
        const extra = e.derivable === true ? ' Puede tomarse en una ciudad y procesarse en otra.' : e.derivable === false ? ' No conviene derivarla a otra ciudad.' : '';
        alerts.append(h('p', { class: 'notice' }, h('strong', {}, `${short(e.name, 60)}, estabilidad de la muestra: `), e.stability + extra));
      }
    }
  }

  function renderFonasa() {
    fonasa.replaceChildren();
    if (!selected.length) return;
    const exams = selected.map((id) => examById.get(id)!);
    if (exams.every((e) => e.noFonasa)) {
      fonasa.append(h('h3', {}, 'Valor FONASA'), h('p', { class: 'notice' }, 'FONASA no valoriza estos exámenes en su arancel de Libre Elección: se pagan al precio del prestador, sin bono de FONASA. Algunas isapres pueden cubrirlos según tu plan.'));
      return;
    }
    fonasa.append(h('h3', {}, 'Valor de referencia FONASA'));

    const rows = [0, 1, 2].map((i) => {
      const missing = exams.filter((e) => !e.lv[i]);
      if (missing.length) {
        return h('tr', {}, h('th', { scope: 'row' }, `Nivel ${i + 1}`),
          h('td', { colspan: '3', class: 'muted' }, `No disponible: ${missing.map((m) => short(m.name, 40)).join(', ')} no tiene valor en este nivel`));
      }
      const t = exams.reduce((s, e) => s + e.lv[i]![0], 0);
      const b = exams.reduce((s, e) => s + e.lv[i]![1], 0);
      return h('tr', {}, h('th', { scope: 'row' }, `Nivel ${i + 1}`),
        h('td', {}, h('strong', {}, money.format(t))), h('td', {}, money.format(b)), h('td', {}, money.format(t - b)));
    });
    fonasa.append(h('div', { class: 'table-wrap' }, h('table', {},
      h('thead', {}, h('tr', {}, ...['Nivel', 'Valor total', 'Bonificación FONASA', 'Copago estimado'].map((t) => h('th', { scope: 'col' }, t)))),
      h('tbody', {}, ...rows))));
    fonasa.append(h('p', { class: 'muted small' },
      'Fuente: Arancel MLE 2026 de FONASA. El valor depende del nivel de inscripción del prestador. El copago estimado es el total menos la bonificación y aplica a beneficiarios FONASA que usan bono en Libre Elección. Es una referencia oficial, no el precio de un prestador específico.'));
  }

  function renderResults() {
    results.replaceChildren();
    if (!selected.length) return;

    results.append(h('h3', {}, 'Precios en prestadores'));

    // Mientras llegan los precios no se muestra una tabla incompleta que parezca definitiva.
    if (selected.some((id) => loading.has(id))) {
      results.append(h('p', { class: 'muted' }, 'Cargando precios…'));
      return;
    }
    const failedNames = selected.filter((id) => failed.has(id)).map((id) => short(examById.get(id)!.name, 40));
    if (failedNames.length) {
      const retry = h('button', { type: 'button' }, 'Reintentar');
      retry.addEventListener('click', () => { selected.forEach((id) => failed.has(id) && loadOffers(id)); renderResults(); });
      results.append(h('p', { class: 'notice' }, `No pudimos cargar los precios de: ${failedNames.join(', ')}. `, retry));
      return;
    }

    const all = buildGroups();
    const complete = all.filter((g) => g.items.size === selected.length);
    const partial = all.filter((g) => g.items.size < selected.length).sort(byName);

    // Regla de independencia: solo precio, comuna o alfabeto.
    if (order === 'price') complete.sort((a, b) => total(a) - total(b) || byName(a, b));
    else if (order === 'subdivision') complete.sort((a, b) => collator.compare(firstSub(a), firstSub(b)) || byName(a, b));
    else complete.sort(byName);

    const pool = poolOffers();
    if (!pool.some(visible)) {
      results.append(h('p', { class: 'notice' }, selected.every((id) => examById.get(id)!.noFonasa) ? 'Aún no tenemos precios de prestadores para estos exámenes. Suelen procesarse en laboratorios de derivación: consulta directamente a un laboratorio o clínica y pregunta si lo toman y a qué valor.' : 'Aún no tenemos precios de prestadores para estos exámenes. Usa el valor FONASA como referencia y consulta directamente al laboratorio o clínica.'));
      return;
    }

    const regions = [...new Set(Object.values(data.subRegions).filter(Boolean))].sort(collator.compare);
    const subs = [...new Set(pool.filter(visible).flatMap((o) => o.subdivisions.filter(inRegion)))].sort(collator.compare);
    if (sub && !subs.includes(sub)) sub = '';
    const ctl = h('div', { class: 'controls' });
    const grp = h('div', { role: 'group', 'aria-label': 'Ordenar por' }, h('span', {}, 'Ordenar por: '));
    ([['price', 'Precio total'], ['subdivision', Sub], ['alpha', 'Alfabético']] as const).forEach(([k, label]) => {
      const b = h('button', { type: 'button', 'aria-pressed': String(order === k) }, label);
      b.addEventListener('click', () => { order = k; renderResults(); });
      grp.append(b);
    });
    ctl.append(grp);
    if (regions.length > 1) {
      const rsel = h('select', { id: 'cz-region' }, h('option', { value: '' }, 'Todo Chile')) as HTMLSelectElement;
      regions.forEach((r) => rsel.append(h('option', { value: r }, r)));
      rsel.value = region;
      rsel.addEventListener('change', () => { region = rsel.value; sub = ''; renderResults(); });
      ctl.append(h('label', {}, 'Región: ', rsel));
    }
    if (subs.length) {
      const sel = h('select', { id: 'cz-sub' }, h('option', { value: '' }, 'Todas')) as HTMLSelectElement;
      subs.forEach((s) => sel.append(h('option', { value: s }, s)));
      sel.value = sub;
      sel.addEventListener('change', () => { sub = sel.value; renderResults(); });
      ctl.append(h('label', {}, `${Sub}: `, sel));
    }
    results.append(ctl);

    if (complete.length) results.append(table(complete, true));
    else results.append(h('p', { class: 'notice' }, 'Ningún prestador tiene precio para todos tus exámenes. Abajo ves cotizaciones parciales.'));

    if (partial.length) {
      results.append(h('h3', {}, 'Cotizaciones parciales'), h('p', { class: 'muted small' }, 'Estos prestadores no tienen precio cargado para algún examen de tu orden.'));
      results.append(table(partial, false));
    }
    results.append(h('p', { class: 'muted small' }, 'Total particular es el precio publicado por el prestador. Si te atiendes con FONASA (bono de Libre Elección) pagas el arancel del nivel en que está inscrito el prestador, no su precio particular; el copago es el arancel menos el bono. El nivel se muestra solo cuando el prestador lo informa.'), h('p', { class: 'muted small' }, 'Si un prestador tiene varias sedes o precios del mismo examen, se usa el más bajo. Los precios son referenciales: confírmalos con el prestador.'));
  }

  /* Atención con FONASA: el prestador cobra el arancel de su nivel, no su precio particular. */
  function fonasaCell(g: Group, isComplete: boolean): (Node | string)[] {
    if (!g.fonasaLevel) return [h('span', { class: 'muted small' }, 'Nivel FONASA no informado')];
    const i = g.fonasaLevel - 1;
    const ex = [...g.items.keys()].map((id) => examById.get(id)!);
    if (ex.some((e) => !e.lv[i])) return [h('span', { class: 'tag' }, `FONASA nivel ${g.fonasaLevel}`), h('div', { class: 'muted small' }, 'Sin valor de arancel en este nivel para algún examen')];
    const t = ex.reduce((s, e) => s + e.lv[i]![0], 0);
    const b = ex.reduce((s, e) => s + e.lv[i]![1], 0);
    return [
      h('span', { class: 'tag' }, `FONASA nivel ${g.fonasaLevel}`),
      h('div', {}, h('strong', {}, money.format(t - b)), ' de copago'),
      h('div', { class: 'muted small' }, `Arancel ${money.format(t)}, bono ${money.format(b)}${isComplete ? '' : ' (solo exámenes cotizados)'}`),
    ];
  }

  function table(groups: Group[], isComplete: boolean) {
    const head = h('tr', {}, ...['Prestador', isComplete ? 'Total particular' : 'Subtotal particular', 'Con FONASA', 'Detalle', Sub, 'Verificado'].map((t) => h('th', { scope: 'col' }, t)));
    const body = groups.map((g) => {
      const name = g.website ? h('a', { href: g.website, rel: 'noopener nofollow' }, g.provider) : g.provider;
      const detail = selected.map((id) => {
        const o = g.items.get(id);
        return h('div', { class: 'small' }, `${short(examById.get(id)!.name, 40)}: `, o ? money.format(o.amount) : h('em', {}, 'sin precio'));
      });
      const stale = (Date.now() - new Date(g.oldest).getTime()) / 86400000 > data.staleDays;
      return h('tr', {},
        h('th', { scope: 'row' }, name, h('div', { class: 'muted small' }, kindLabel[g.kind] ?? g.kind)),
        h('td', {}, h('strong', {}, money.format(total(g)))),
        h('td', {}, ...fonasaCell(g, isComplete)),
        h('td', {}, ...detail),
        h('td', {}, g.subs.size ? [...g.subs].sort(collator.compare).join(', ') : 'Todas'),
        h('td', {}, dateFmt.format(new Date(g.oldest)), stale ? h('div', { class: 'stale small' }, 'Por reconfirmar') : ''),
      );
    });
    return h('div', { class: 'table-wrap' }, h('table', {}, h('thead', {}, head), h('tbody', {}, ...body)));
  }

  function renderPrep() {
    prep.replaceChildren();
    if (!selected.length) return;
    const items = selected.map((id) => examById.get(id)!);
    const withGuide = items.filter((e) => e.guide);
    const without = items.filter((e) => !e.guide);

    prep.append(h('h3', {}, '¿Necesitas prepararte?'));
    if (withGuide.length) {
      const list = h('ul', { class: 'prep-list' });
      withGuide.forEach((e) => {
        const flag = e.fastingRequired ? 'prep-yes' : 'prep-no';
        list.append(h('li', {}, h('strong', {}, short(e.name, 60)), ' ', h('span', { class: `tag ${flag}` }, e.fasting), ' ',
          h('a', { href: `/preparacion/${e.guide}/` }, 'Ver preparación')));
      });
      prep.append(list);
    }
    if (without.length) {
      prep.append(h('p', { class: 'muted' }, `Aún no tenemos guía de preparación para: ${without.map((e) => short(e.name, 40)).join(', ')}. Pregunta al prestador si requiere ayuno u otra indicación.`));
    }
    if (items.some((e) => e.fastingRequired)) {
      prep.append(h('p', { class: 'notice' }, 'Si alguno de tus exámenes requiere ayuno, lo habitual es ir en ayuno para toda la toma de muestra. Confírmalo con el laboratorio.'));
    }
  }

  render();
</script>

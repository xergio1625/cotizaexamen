---
import Base from '../layouts/Base.astro';
import Cotizador from '../components/Cotizador.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '../../site.config';

const { modules, country } = siteConfig;
const [arancel, providers, prices] = await Promise.all([
  getCollection('arancel'),
  getCollection('providers'),
  getCollection('prices'),
]);
---

<Base>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-text">
        <h1>{siteConfig.tagline}</h1>
        <p>
          ¿Te pidieron exámenes de laboratorio? Busca cada examen de tu orden y mira cuánto vale {country.areaLabel}:
          valores de referencia oficiales de FONASA (Libre Elección, niveles 1, 2 y 3) y precios de prestadores.
        </p>
        <ul class="stats">
          <li><strong data-count={arancel.length}>{arancel.length}</strong><span>exámenes con valor FONASA</span></li>
          <li><strong data-count={providers.length}>{providers.length}</strong><span>prestadores</span></li>
          <li><strong data-count={prices.length}>{prices.length}</strong><span>precios verificados</span></li>
        </ul>
      </div>
      <div class="hero-art reveal" data-reveal="right" data-parallax>
        <div class="layer" data-depth="18">
          <img src="/img/portada.webp" alt="" width="1408" height="768" loading="eager" decoding="async" />
        </div>
      </div>
    </div>
  </section>

  <div class="container">
    {modules.prices && <Cotizador />}

    <div class="prose">
      <p class="notice">
        <strong>Sitio independiente.</strong> Ningún laboratorio ni clínica paga por aparecer ni por mejor
        posición. Los resultados se ordenan solo por precio, {country.subdivisionLabel} o alfabeto.
        <a href="/sobre-el-sitio/">Cómo se financia y quién lo hace</a>.
      </p>
      {modules.preparation && (
        <p class="muted">
          ¿Quieres saber cómo prepararte para un examen? Revisa las <a href="/preparacion/">guías de preparación</a>.
        </p>
      )}
    </div>
  </div>
</Base>

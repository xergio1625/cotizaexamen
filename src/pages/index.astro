---
import Base from '../layouts/Base.astro';
import Cotizador from '../components/Cotizador.astro';
import { siteConfig } from '../../site.config';

const { modules, country } = siteConfig;
---

<Base>
  <section class="hero">
    <div class="container">
      <h1>{siteConfig.tagline}</h1>
      <p>
        ¿Te pidieron exámenes de laboratorio? Cotiza tu orden completa y compara cuánto cuesta en cada prestador
        {country.areaLabel}.
      </p>
    </div>
  </section>

  <div class="container">
    {modules.prices && <Cotizador />}

    <div class="prose">
      <p class="notice">
        <strong>Sitio independiente.</strong> Ningún laboratorio ni clínica paga por aparecer ni por mejor
        posición. Los resultados se ordenan solo por precio, {country.subdivisionLabel} o alfabeto.
        <a href="/sobre-el-sitio/">Cómo se financia y quién lo hace</a>.
      </p>
      {modules.preparation && (
        <p class="muted">
          ¿Quieres saber cómo prepararte para un examen? Revisa las <a href="/preparacion/">guías de preparación</a>.
        </p>
      )}
    </div>
  </div>
</Base>

---
import Base from '../../layouts/Base.astro';
import PriceTable from '../../components/PriceTable.astro';
import FonasaTable from '../../components/FonasaTable.astro';
import { siteConfig } from '../../../site.config';
import { orderOffers, type OrderKey } from '../../lib/ordering';
import { getPriceRows, groupOffers } from '../../lib/prices';
import { getArancel, LEVELS, fastingText } from '../../lib/arancel';
import { breadcrumbLd, examServiceLd, faqLd } from '../../lib/jsonld';
import { formatMoney, formatDate } from '../../lib/format';
import { slugifyComuna } from '../../lib/comunas';

export async function getStaticPaths() {
  if (!siteConfig.modules.prices) return [];
  const [items, allRows] = await Promise.all([getArancel(), getPriceRows()]);
  return items.map((item) => ({
    params: { slug: item.slug },
    props: { item, rows: groupOffers(allRows.filter((r) => r.examId === item.id)) },
  }));
}

const { item, rows } = Astro.props;
const sub = siteConfig.country.subdivisionLabel;
const Sub = sub[0].toUpperCase() + sub.slice(1);
const orders: { key: OrderKey; label: string }[] = [
  { key: 'price', label: 'Precio' },
  { key: 'subdivision', label: Sub },
  { key: 'alpha', label: 'Alfabético' },
];
const subdivisions = [...new Set(rows.flatMap((r) => r.subdivisions))].sort((a, b) => a.localeCompare(b, 'es'));

const levelList = LEVELS.flatMap((n) => (item.levels[n] ? [{ level: n, ...item.levels[n]! }] : []));
const n1 = item.levels['1'];
const title = `Precio del examen de ${item.name}`;
const byPrice = orderOffers(rows, 'price');
const cheapest = byPrice[0];
const newest = rows.length ? new Date(Math.max(...rows.map((r) => r.verifiedAt.getTime()))) : undefined;
const year = (newest ?? new Date()).getUTCFullYear();
const seoFrom = cheapest ? cheapest.amount : n1?.total;
// Título de la pestaña y buscadores: precio inicial y año (el H1 sigue siendo `title`).
const seoTitle = `${item.name}: precio${seoFrom ? ` desde ${formatMoney(seoFrom)}` : ''} ${siteConfig.country.areaLabel} ${year}`;

const nProv = new Set(rows.map((r) => r.providerName)).size;
const faq: { q: string; a: string }[] = [];
if (cheapest) {
  const max = byPrice[byPrice.length - 1];
  faq.push({
    q: `¿Cuánto cuesta el examen de ${item.name}?`,
    a:
      cheapest.amount === max.amount
        ? `Según los precios publicados, cuesta ${formatMoney(cheapest.amount)} (${nProv} ${nProv === 1 ? 'prestador' : 'prestadores'}).`
        : `Según los precios publicados, cuesta entre ${formatMoney(cheapest.amount)} y ${formatMoney(max.amount)} (${nProv} ${nProv === 1 ? 'prestador' : 'prestadores'}). El valor depende del prestador y de si incluye la toma de muestra.`,
  });
  faq.push({
    q: `¿Dónde está el precio más bajo publicado para ${item.name}?`,
    a: `El más bajo que tenemos es ${formatMoney(cheapest.amount)} en ${cheapest.providerName}${cheapest.subdivisions.length ? ` (${cheapest.subdivisions.length > 3 ? `${cheapest.subdivisions.length} comunas` : cheapest.subdivisions.join(', ')})` : ''}, verificado el ${formatDate(cheapest.verifiedAt)}. Los precios cambian: confírmalo con el prestador.`,
  });
}
const range = (v: number[]) => {
  const lo = Math.min(...v);
  const hi = Math.max(...v);
  return lo === hi ? `es de ${formatMoney(lo)}` : `va de ${formatMoney(lo)} a ${formatMoney(hi)}`;
};
if (!item.noFonasa && levelList.length) {
  const totals = levelList.map((l) => l.total);
  const copagos = levelList.map((l) => l.total - l.benef);
  faq.push({
    q: `¿Cuál es el valor FONASA y el copago de ${item.name}?`,
    a: `En el Arancel MLE 2026 de FONASA el valor total ${range(totals)} según el nivel del prestador, y el copago estimado con bono de Libre Elección ${range(copagos)}. Revisa la tabla por nivel en esta página.`,
  });
}
if (item.guide) {
  faq.push({
    q: `¿Necesito ayuno para el examen de ${item.name}?`,
    a: `${fastingText(item.fasting)}. Si tu médico o el laboratorio te dieron otras indicaciones, sigue siempre las de ellos. Detalle en la guía de preparación.`,
  });
}
const description =
  (item.noFonasa ? `Examen ${item.name} (sin valor FONASA)` : `Valor del examen ${item.name} (código FONASA ${item.code})`) +
  (n1 ? `: desde ${formatMoney(n1.total)} en el Arancel MLE 2026` : '') +
  (rows.length ? ` y ${rows.length} ${rows.length === 1 ? 'precio' : 'precios'} de prestadores.` : '.');

const ld = [
  examServiceLd({
    name: item.name,
    description: `${item.official}. ${item.section}.`,
    path: Astro.url.pathname,
    code: item.noFonasa ? '' : item.code,
    levels: levelList,
    offers: orderOffers(rows, 'price').map((r) => ({
      ...r,
      subdivision: r.subdivisions.length > 3 ? `${r.subdivisions.length} comunas` : r.subdivisions.join(', ') || undefined,
    })),
    lastVerified: rows.length ? new Date(Math.max(...rows.map((r) => r.verifiedAt.getTime()))) : undefined,
  }),
  breadcrumbLd([
    { name: 'Inicio', path: '/' },
    { name: 'Cotizar', path: '/precios/' },
    { name: item.name, path: Astro.url.pathname },
  ]),
  ...(faq.length ? [faqLd(faq)] : []),
];
---

<Base jsonLd={ld} title={seoTitle} description={description} noindex={item.noFonasa && rows.length === 0}>
  <div class="container">
    <div class="prose">
      <p class="muted"><a href="/precios/">Cotizar</a> › {item.section}</p>
      <h1>{title}</h1>
      {item.noFonasa
        ? <p class="muted"><strong>Sin código FONASA</strong>: examen especializado que el arancel oficial no valoriza.</p>
        : <p class="muted">Código FONASA <strong>{item.code}</strong></p>}
      <p class="muted small">{item.official}</p>

      {item.urgent && (
        <p class="notice notice-urgent">
          <strong>Examen que no admite demora.</strong> {item.urgent.note}
        </p>
      )}

      {item.stability && (
        <p class="notice">
          <strong>Estabilidad de la muestra:</strong> {item.stability.text}
          {item.stability.derivable === true && ' Puede tomarse en una ciudad y procesarse en otra.'}
          {item.stability.derivable === false && ' No conviene derivarla a otra ciudad.'}
        </p>
      )}

      {item.guide && (
        <p class="notice">
          <strong>Preparación:</strong> {fastingText(item.fasting)}.
          <a href={`/preparacion/${item.guide}/`}>Ver cómo prepararte</a>
        </p>
      )}
    </div>

    {item.noFonasa ? (
      <>
        <h2>Valor FONASA</h2>
        <p class="prose">
          FONASA no tiene valor para este examen en su arancel de Libre Elección: se paga el precio del prestador
          (valor particular), sin bono de FONASA. Algunas isapres pueden cubrirlo según tu plan.
        </p>
      </>
    ) : (
      <>
        <h2>Valor de referencia FONASA</h2>
        <FonasaTable levels={item.levels} />
        <p class="muted small prose">
          Fuente: FONASA, Arancel de Prestaciones de Salud 2026, Modalidad Libre Elección. El valor depende del nivel
          de inscripción del prestador. El copago estimado es el valor total menos la bonificación y aplica a
          beneficiarios FONASA que usan bono en Libre Elección; otras coberturas o convenios pueden variar. Es una
          referencia, no el precio de un prestador específico.
        </p>
      </>
    )}

    <h2>Precios en prestadores</h2>
    {rows.length === 0 ? (
      <p class="prose">Aún no tenemos precios de prestadores para este examen. Consulta directamente al laboratorio o clínica.</p>
    ) : (
      <>
        <p class="notice prose">
          Orden solo por precio, {sub} o alfabeto. Ningún prestador paga por aparecer ni por mejor posición.
        </p>
        <div class="controls" id="controls" hidden>
          <div role="group" aria-label="Ordenar por">
            <span>Ordenar por:</span>
            {orders.map((o, i) => (
              <button type="button" data-order-btn={o.key} aria-pressed={i === 0 ? 'true' : 'false'}>{o.label}</button>
            ))}
          </div>
          {subdivisions.length > 0 && (
            <label>
              {Sub}:
              <select id="sub-filter">
                <option value="">Todas</option>
                {subdivisions.map((s) => <option value={s}>{s}</option>)}
              </select>
            </label>
          )}
        </div>
        {orders.map((o, i) => (
          <section data-order={o.key} hidden={i !== 0 ? true : undefined} aria-label={`Ordenado por ${o.label.toLowerCase()}`}>
            <PriceTable rows={orderOffers(rows, o.key)} />
          </section>
        ))}
        {subdivisions.length > 0 && (
          <p class="prose">
            <strong>Precios por {sub}:</strong>
            {subdivisions.map((s, i) => (
              <>{i > 0 ? ' · ' : ' '}<a href={`/comunas/${slugifyComuna(s)}/`}>{s}</a></>
            ))}
          </p>
        )}
        <p class="muted small prose">
          Precios particulares referenciales, salvo que se indique otro tipo. Pueden cambiar sin aviso y no incluyen
          necesariamente la toma de muestra u otros cargos. Verifica con el prestador.
        </p>
      </>
    )}

    {faq.length > 0 && (
      <>
        <h2>Preguntas frecuentes</h2>
        <div class="prose">
          {faq.map((f) => (
            <>
              <h3>{f.q}</h3>
              <p>{f.a}</p>
            </>
          ))}
        </div>
      </>
    )}
  </div>
</Base>

<script>
  const controls = document.getElementById('controls');
  const sections = document.querySelectorAll<HTMLElement>('[data-order]');
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-order-btn]');
  const filter = document.getElementById('sub-filter') as HTMLSelectElement | null;

  if (controls) controls.hidden = false;

  buttons.forEach((b) =>
    b.addEventListener('click', () => {
      buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      sections.forEach((s) => (s.hidden = s.dataset.order !== b.dataset.orderBtn));
    }),
  );

  filter?.addEventListener('change', () => {
    document.querySelectorAll<HTMLElement>('tbody tr').forEach((tr) => {
      const subs = tr.dataset.subs;
      if (subs === undefined) return;
      // Sin comunas = vale para todas.
      tr.hidden = !!filter.value && subs !== '' && !subs.split('|').includes(filter.value);
    });
  });
</script>

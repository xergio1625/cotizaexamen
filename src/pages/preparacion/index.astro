---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { siteConfig } from '../../../site.config';
import { categoryLabels } from '../../lib/categories';
import { fastingText } from '../../lib/arancel';

const exams = (await getCollection('exams', (e) => !e.data.draft)).sort((a, b) =>
  a.data.title.localeCompare(b.data.title, 'es'),
);
const groups = Object.entries(categoryLabels)
  .map(([key, label]) => ({ label, items: exams.filter((e) => e.data.category === key) }))
  .filter((g) => g.items.length);
---

<Base
  title="Preparación de exámenes de laboratorio"
  description="Guías claras para prepararte: ayuno, horarios y qué llevar para cada examen de laboratorio."
>
  <PageHero
    title="Preparación de exámenes"
    lead="Cómo llegar bien preparado a tu toma de muestra: ayuno, qué llevar y qué preguntar. Si tu médico o el laboratorio te dieron indicaciones distintas, sigue siempre las de ellos."
    img="/img/preparacion.webp"
  />
  <div class="container prose">
    {groups.map((g) => (
      <section>
        <h2>{g.label}</h2>
        <ul>
          {g.items.map((e) => (
            <li>
              <a href={`/preparacion/${e.id}/`}>{e.data.title}</a>
              <span class="muted"> · {fastingText(e.data.fasting)}</span>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</Base>
